<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.dfa1.typesafe-java</groupId>
    <artifactId>typesafe-java</artifactId>
    <version>0.1-SNAPSHOT</version>
  </parent>

  <artifactId>typesafe-java-acceptance</artifactId>
  <packaging>jar</packaging>

  <name>TypeSafe Acceptance Tests</name>
  <description>
    Tests TypesafeClient end-to-end against the live TypeSafe API, once per HttpTransport/
    JsonCodec combination. Not published — exists only to run its own tests.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.github.dfa1.typesafe-java</groupId>
      <artifactId>typesafe-java-core</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>io.github.dfa1.typesafe-java</groupId>
      <artifactId>typesafe-java-jdk-http-client</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>io.github.dfa1.typesafe-java</groupId>
      <artifactId>typesafe-java-jackson2</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>io.github.dfa1.typesafe-java</groupId>
      <artifactId>typesafe-java-jackson3</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- jackson2 and jackson3 are both on this module's test classpath, and both pull in
         com.fasterxml.jackson.core:jackson-annotations transitively — jackson2 at 2.17.2,
         jackson3 at 2.20. Maven's dependency mediation would otherwise pick the nearer/older
         2.17.2, which is missing a field jackson3's databind code needs at runtime
         (JsonFormat.Shape.POJO), failing with NoSuchFieldError. Pin the newer, backward-
         compatible version explicitly so both codecs share it. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <version>2.20</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
