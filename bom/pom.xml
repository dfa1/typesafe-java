<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.dfa1.typesafe-java</groupId>
    <artifactId>typesafe-java</artifactId>
    <version>0.7.0-SNAPSHOT</version>
  </parent>

  <artifactId>typesafe-java-bom</artifactId>
  <packaging>pom</packaging>

  <name>TypeSafe BOM</name>
  <description>Bill of Materials for typesafe-java. Import in dependencyManagement to get
    consistent versions of core/client-jdk/client-okhttp/jackson2/jackson3/testkit/mapping.
  </description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.dfa1.typesafe-java</groupId>
        <artifactId>typesafe-java-core</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>io.github.dfa1.typesafe-java</groupId>
        <artifactId>typesafe-java-client-jdk</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>io.github.dfa1.typesafe-java</groupId>
        <artifactId>typesafe-java-client-okhttp</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>io.github.dfa1.typesafe-java</groupId>
        <artifactId>typesafe-java-jackson2</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>io.github.dfa1.typesafe-java</groupId>
        <artifactId>typesafe-java-jackson3</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>io.github.dfa1.typesafe-java</groupId>
        <artifactId>typesafe-java-testkit</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>io.github.dfa1.typesafe-java</groupId>
        <artifactId>typesafe-java-mapping</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>io.github.dfa1.typesafe-java</groupId>
        <artifactId>typesafe-java-local</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- Flattens the published POM: drops the typesafe-java parent reference and
           writes every managed dependency's ${project.version} out literally.
           Importers get the BOM without also resolving the typesafe-java parent.
           Consumers still import it as <type>pom</type><scope>import</scope>. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten-maven-plugin.version}</version>
        <configuration>
          <flattenMode>bom</flattenMode>
          <pomElements>
            <properties>remove</properties>
          </pomElements>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten.clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
